# Copy this file to .dev.vars and paste your keys. wrangler reads it in local dev.
# For production set the same names as secrets: npx wrangler secret put OPENAI_API_KEY

# Required: the tutor's voice (gpt-4o-mini-tts). Also unlocks the gpt-5.6-* models
# and the optional OpenAI speech recognition.
OPENAI_API_KEY=

# The default model is claude-sonnet-5, so you want this one too.
ANTHROPIC_API_KEY=

# Only if you want to use Gemini.
GOOGLE_API_KEY=

# Optional, recommended before deploying publicly. When set, every API call must
# carry this token; paste the same value into the settings drawer in the app.
ACCESS_TOKEN=
# Optional: comma-separated origins allowed to call the API when deployed.
ALLOWED_ORIGINS=

# Optional: lets the tutor read GitHub pull requests and issues without hitting
# the 60/hour anonymous limit (and private repos you can see).
GITHUB_TOKEN=
